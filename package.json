{
  "name": "dijiterminal",
  "productName": "DijiTerminal",
  "version": "0.2.0",
  "private": true,
  "description": "iTerm2'de paralel çalışan Claude Code session'larını ikinci monitörden takip etmek için macOS uygulaması",
  "author": "Ufuk Aytaş",
  "license": "MIT",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:demo": "DIJI_DEMO=1 electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/fix-node-pty.mjs && node scripts/ensure-electron.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "pretest": "node scripts/check-fixtures.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:hooks": "sh tests/hooks/run-all.sh",
    "test:all": "npm test && npm run test:hooks",
    "build:mac": "npm run dist",
    "dist": "electron-vite build && electron-builder --mac",
    "dist:universal": "electron-vite build && electron-builder --mac dmg --universal",
    "dist:dir": "electron-vite build && electron-builder --mac --dir",
    "dist:signed": "electron-vite build && electron-builder --mac -c.mac.identity=\"$CSC_NAME\" -c.mac.hardenedRuntime=true -c.dmg.sign=true && node scripts/notarize-dmg.mjs",
    "dist:notarize-dmg": "node scripts/notarize-dmg.mjs",
    "dist:check": "node scripts/check-package-config.mjs",
    "icon": "node scripts/make-icon.mjs",
    "icon:tray": "node scripts/make-tray-icons.mjs",
    "hooks:install": "node scripts/install-hooks.mjs install",
    "hooks:uninstall": "node scripts/install-hooks.mjs uninstall",
    "hooks:status": "node scripts/install-hooks.mjs status",
    "fixtures:make": "node scripts/make-fixtures.mjs",
    "fixtures:check": "node scripts/check-fixtures.mjs",
    "replay": "node scripts/replay.mjs",
    "bench:transcripts": "node scripts/bench-transcripts.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:hidden": "node scripts/bench.mjs --hidden",
    "bench:terminal": "node scripts/bench.mjs --terminal",
    "bench:big": "node scripts/bench.mjs --big",
    "bench:soak": "node scripts/bench.mjs --soak",
    "bench:headless": "node scripts/bench.mjs --headless --hidden"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tanstack/react-virtual": "3.13.19",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "3.6.0",
    "node-pty": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "2.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "25.0.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
